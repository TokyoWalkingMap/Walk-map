[{"key": "overview", "z": 9, "bbox": [33.55, 134.35, 35.7, 136.4], "title": "関西", "en": "Kansai", "lede": "大阪・京都・兵庫・奈良・滋賀・和歌山の、橋やダムなどの土木と、城や寺社、近代建築の名所を一枚の地図に集めた全体図。", "skip": ["residential", "tertiary", "secondary", "pedestrian"], "rw": {"motorway": 1.6, "primary": 1.1}, "labels": [["大阪", 34.69, 135.5], ["京都", 35.02, 135.76], ["神戸", 34.7, 135.19], ["奈良", 34.62, 135.83], ["和歌山", 34.23, 135.17], ["大津", 35.04, 135.9], ["琵琶湖", 35.25, 136.05], ["姫路", 34.82, 134.7], ["淡路島", 34.4, 134.85], ["大阪湾", 34.5, 135.15], ["彦根", 35.28, 136.25], ["舞鶴", 35.46, 135.33], ["高野山", 34.21, 135.6]]}, {"key": "osaka", "bbox": [34.675, 135.485, 34.715, 135.545], "title": "大阪・中之島", "en": "Osaka & Nakanoshima", "lede": "大阪城と、堂島川と土佐堀川にはさまれた中之島。公会堂や図書館、淀屋橋・大江橋などの橋、梅田の超高層まで。水の都の土木と建築を歩くエリア。", "labels": [["中之島", 34.693, 135.493], ["梅田", 34.705, 135.496], ["北浜", 34.69, 135.506], ["天満橋", 34.6925, 135.5165]]}, {"key": "minami", "bbox": [34.635, 135.48, 34.675, 135.54], "title": "ミナミ・天王寺", "en": "Minami & Tennoji", "lede": "道頓堀の戎橋から、新世界の通天閣、300mのあべのハルカス、四天王寺まで。大阪の南の繁華街に、塔と高層ビルが並ぶエリア。", "labels": [["道頓堀", 34.6685, 135.503], ["難波", 34.666, 135.5], ["新世界", 34.652, 135.508], ["天王寺", 34.646, 135.516]]}, {"key": "okazaki", "bbox": [34.998, 135.774, 35.028, 135.806], "title": "岡崎・蹴上（琵琶湖疏水）", "en": "Okazaki & Keage", "lede": "琵琶湖から引いた疏水が流れる岡崎と蹴上。水路閣、インクライン、日本初の水力発電所、平安神宮や美術館が並ぶ。水の土木と近代建築を歩くエリア。", "labels": [["岡崎", 35.014, 135.782], ["蹴上", 35.0105, 135.789], ["南禅寺", 35.0113, 135.794], ["三条", 35.009, 135.777]]}, {"key": "kyoto", "bbox": [34.975, 135.735, 35.04, 135.79], "title": "京都 中心部", "en": "Central Kyoto", "lede": "京都駅と京都タワー、鴨川に架かる三条・四条・五条の橋、二条城、東寺、清水寺、同志社まで。古建築と近代建築、橋を歩くエリア。", "labels": [["京都駅", 34.9858, 135.7588], ["四条", 35.0038, 135.764], ["河原町", 35.005, 135.769], ["御所", 35.0254, 135.762], ["祇園", 35.0036, 135.775], ["東寺", 34.9805, 135.7477]]}, {"key": "kobe", "bbox": [34.655, 135.16, 34.72, 135.225], "title": "神戸・三宮", "en": "Kobe & Sannomiya", "lede": "神戸港のポートタワー、旧居留地の洋館、北野の異人館、六甲の山すそに築かれた布引ダムまで。港町の土木と建築を歩くエリア。", "labels": [["三宮", 34.6948, 135.1931], ["元町", 34.69, 135.187], ["北野", 34.6985, 135.196], ["神戸港", 34.678, 135.19]]}, {"key": "nara", "bbox": [34.64, 135.775, 34.7, 135.85], "title": "奈良", "en": "Nara", "lede": "東大寺の大仏殿、興福寺の五重塔、正倉院から、西ノ京の薬師寺・唐招提寺、平城宮跡まで。千年以上前の木造建築と、復原された宮殿を歩くエリア。", "labels": [["奈良公園", 34.685, 135.843], ["近鉄奈良", 34.684, 135.828], ["西ノ京", 34.67, 135.787], ["平城宮跡", 34.69, 135.793], ["郡山", 34.649, 135.782]]}]